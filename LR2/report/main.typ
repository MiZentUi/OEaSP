= Основные фрагменты исходного кода

== Чтение и запись с учётом неполных запросов и EINTR

#stp2024.listing[Обёртки read_exact и write_all][
  ```
  bool readExact(int fd, void* buf, std::size_t len) {
      auto* p = static_cast<char*>(buf);
      std::size_t done = 0;
      while (done < len) {
          const ssize_t n = ::read(fd, p + done, len - done);
          if (n < 0) {
              if (errno == EINTR) continue;
              return false;
          }
          if (n == 0) { errno = 0; return false; }  // преждевременный EOF
          done += static_cast<std::size_t>(n);
      }
      return true;
  }

  bool writeAll(int fd, const void* buf, std::size_t len) {
      auto* p = static_cast<const char*>(buf);
      std::size_t done = 0;
      while (done < len) {
          const ssize_t n = ::write(fd, p + done, len - done);
          if (n < 0) {
              if (errno == EINTR) continue;
              return false;
          }
          if (n == 0) return false;
          done += static_cast<std::size_t>(n);
      }
      return true;
  }
  ```
] <code-io>

== Little-endian кодирование числа

#stp2024.listing[Функции put_le и get_le][
  ```
  void put_le(Bytes& out, std::uint64_t value, int width) {
      for (int i = 0; i < width; ++i) {
          out.push_back(static_cast<std::uint8_t>(value & 0xffu));
          value >>= 8;
      }
  }
  std::uint64_t get_le(const Bytes& bytes, std::size_t pos, int width) {
      std::uint64_t value = 0;
      for (int i = 0; i < width; ++i)
          value |= static_cast<std::uint64_t>(bytes[pos + i]) << (8 * i);
      return value;
  }
  ```
] <code-le>

== Обход записей и проверка структуры

#stp2024.listing[Функция обхода traverse][
  ```
  bool traverse(int fd, std::uint64_t count,
                const std::function<bool(const codec::Record&)>& fn,
                std::string& err) {
      off_t fsize = 0;
      if (!getSize(fd, fsize)) { err = "failed to get file size"; return false; }
      std::array<std::uint8_t, kRecordHeader> raw{};
      for (std::uint64_t i = 0; i < count; ++i) {
          if (!readExact(fd, raw.data(), raw.size())) {
              err = "truncated record: missing record header"; return false;
          }
          const std::uint64_t tlen = codec::get_le(bytes(raw), 16, 4);
          if (tlen > codec::kMaxText) { err = "text length exceeds the limit"; return false; }
          const off_t pos = ::lseek(fd, 0, SEEK_CUR);
          if (pos + static_cast<off_t>(tlen) > fsize) {
              err = "truncated record: missing text"; return false;
          }
          codec::Record r;
          std::copy(raw.begin(), raw.begin() + 16, r.uuid.begin());
          r.text.resize(tlen);
          if (tlen > 0 && !readExact(fd, r.text.data(), tlen)) return false;
          if (!codec::isAscii(r.text)) { err = "record text is not ASCII"; return false; }
          if (!fn(r)) return false;
      }
      return ::lseek(fd, 0, SEEK_CUR) == fsize;
  }
  ```
] <code-traverse>

