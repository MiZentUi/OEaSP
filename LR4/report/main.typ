#stp2024.appendix(
  title: [Листинг кода генерации графических материалов],
  type: [справочное],
  label: <appendix-figures>,
  [
    Ниже приведены фрагменты `LR4/report/figures.py`: чтение `results.csv`, группировка
    замеров, построение столбчатых SVG-диаграмм с error bars и базовые примитивы схемы
    взаимодействия. Полный файл находится в репозитории и строит `interaction.svg`
    целиком.

    #stp2024.listing[Фрагмент скрипта построения графиков][
      #show raw: set text(size: 7.5pt)
      ```python
      #!/usr/bin/env python3
      import csv
      import math
      import statistics
      from pathlib import Path

      ROOT = Path(__file__).resolve().parent
      DATA = ROOT / "data" / "results.csv"
      CHARTS = ROOT / "charts"
      CHARTS.mkdir(parents=True, exist_ok=True)
      FONT = "DejaVu Sans, Arial, sans-serif"
      BLUE, RED, GRAY, LIGHT = "#1A73E8", "#D93025", "#5F6368", "#E8EAED"

      def load_rows():
          with DATA.open(newline="", encoding="utf-8") as stream:
              return list(csv.DictReader(stream))

      def groups(rows, experiment):
          result = {}
          for row in rows:
              if row["experiment"] == experiment:
                  result.setdefault(row["case"], []).append(row)
          return result

      def mean(values):
          return statistics.mean(values)

      def bar_chart(path, categories, series, y_label, x_label,
                    y_digits=0):
          width, height = 780, 430
          left, right, top, bottom = 100, 35, 35, 95
          plot_w = width - left - right
          plot_h = height - top - bottom
          maximum = max(max(values) for item in series
                        for values in item["values"])
          step = maximum / 4.0
          magnitude = 10 ** math.floor(math.log10(step))
          for multiplier in (1, 2, 2.5, 5, 10):
              if multiplier * magnitude >= step:
                  step = multiplier * magnitude
                  break
          y_max = step * 4
          if y_max < maximum:
              y_max += step

          # svg_header(), text() и line() опущены для краткости
          svg = svg_header(width, height)
          for tick in range(5):
              value = tick * y_max / 4
              y = top + plot_h - (value / y_max) * plot_h
              svg += line(left, y, left + plot_w, y, LIGHT, 1.0)
              svg += text(left - 14, y + 5, f"{value:.{y_digits}f}",
                          13, GRAY, "end")
          svg += line(left, top, left, top + plot_h, "#202124", 1.6)
          svg += line(left, top + plot_h, left + plot_w,
                      top + plot_h, "#202124", 1.6)
          svg += text(left + plot_w / 2, height - 28, x_label, 15)
          svg += text(24, top + plot_h / 2, y_label, 15, "#202124",
                      "middle", extra=f'transform="rotate(-90 24 '
                      f'{top + plot_h / 2:.1f})"')

          group_w = plot_w / len(categories)
          group_inner = group_w * 0.66
          bar_w = group_inner / len(series)
          for index, category in enumerate(categories):
              center = left + group_w * (index + 0.5)
              svg += text(center, top + plot_h + 28, category, 14)
              for series_index, item in enumerate(series):
                  values = item["values"][index]
                  avg, low, high = mean(values), min(values), max(values)
                  x = center - group_inner / 2 + bar_w * (series_index + 0.5)
                  bar_h = (avg / y_max) * plot_h
                  y = top + plot_h - bar_h
                  svg += (f'<rect x="{x - bar_w * 0.36:.1f}" '
                          f'y="{y:.1f}" width="{bar_w * 0.72:.1f}" '
                          f'height="{bar_h:.1f}" fill="{item["color"]}" '
                          f'fill-opacity="0.82"/>\n')
                  low_y = top + plot_h - (low / y_max) * plot_h
                  high_y = top + plot_h - (high / y_max) * plot_h
                  svg += line(x, low_y, x, high_y, GRAY, 1.2)
                  svg += line(x - 5, low_y, x + 5, low_y, GRAY, 1.2)
                  svg += line(x - 5, high_y, x + 5, high_y, GRAY, 1.2)
          svg += "</svg>\n"
          path.write_text(svg, encoding="utf-8")

      def main():
          rows = load_rows()
          read_groups = groups(rows, "read_duration")
          order = ["read_us=0", "read_us=100",
                   "read_us=1000", "read_us=5000"]
          categories = ["0", "100", "1 000", "5 000"]
          throughput = [[float(row["throughput_ops_s"])
                         for row in read_groups[case]] for case in order]
          writer_wait = [[float(row["avg_writer_wait_ms"])
                          for row in read_groups[case]] for case in order]
          reader_wait = [[float(row["avg_reader_wait_ms"])
                          for row in read_groups[case]] for case in order]

          bar_chart(CHARTS / "throughput.svg", categories,
                    [{"name": "среднее по 3 запускам",
                      "color": BLUE, "values": throughput}],
                    "Пропускная способность, операций/с",
                    "Длительность чтения, мкс")
          bar_chart(CHARTS / "wait.svg", categories,
                    [{"name": "Writer", "color": RED,
                      "values": writer_wait},
                     {"name": "Reader", "color": BLUE,
                      "values": reader_wait}],
                    "Среднее ожидание, мс",
                    "Длительность чтения, мкс", y_digits=1)

      if __name__ == "__main__":
          main()
      ```
    ] <lst-figures>

    #stp2024.listing[Фрагмент генерации схемы взаимодействия][
      #show raw: set text(size: 7.5pt)
      ```python
      def interaction_svg(path):
          width, height = 1000, 610
          svg = svg_header(width, height)

          def box(x, y, w, h, fill, stroke, dash=None):
              dash_attr = f' stroke-dasharray="{dash}"' if dash else ""
              return (
                  f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="10" '
                  f'fill="{fill}" stroke="{stroke}" stroke-width="2"{dash_attr}/>\n'
              )

          def arrow(path_data, color="#5F6368", marker="gray", dash=None):
              dash_attr = f' stroke-dasharray="{dash}"' if dash else ""
              return (
                  f'<path d="{path_data}" fill="none" stroke="{color}" '
                  f'stroke-width="2.2" stroke-linecap="round" '
                  f'stroke-linejoin="round" marker-end="url(#arrow-{marker})"{dash_attr}/>\n'
              )

          svg += box(330, 24, 340, 92, "#E8F0FE", BLUE)
          svg += text(500, 56, "MANAGER", 25, weight="bold")
          svg += box(310, 230, 380, 188, "#E6F4EA", GREEN)
          svg += text(500, 262, "СОВМЕСТНАЯ ПАМЯТЬ", 20, weight="bold")
          svg += arrow("M 500 116 V 226", GREEN, "green")
      ```
